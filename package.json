{
  "name": "naplan-learning-assistant-ui",
  "productName": "NAPLAN Learning Assistant",
  "version": "1.0.6",
  "description": "Offline-first NAPLAN practice and learning assistant for Windows.",
  "author": "NAPLAN Learning Assistant",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:dir": "npm run build && electron-builder --win --dir",
    "desktop:package": "npm run build && electron-builder --win nsis portable",
    "generate:bank": "node content/naplan-bank/scripts/generate-bank.mjs",
    "validate:bank": "node content/naplan-bank/scripts/validate-bank.mjs",
    "sync:official-news": "node scripts/sync-official-updates.mjs && node scripts/translate-official-pages.mjs",
    "translate:official-news": "node scripts/translate-official-pages.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs tests/official-updates.test.mjs tests/ai-review.test.mjs tests/exam-guide.test.mjs tests/writing-rubric-guide.test.mjs tests/learning-goals.test.mjs tests/writing-report-summary.test.mjs tests/naplan-schedule.test.mjs tests/window-layout.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "lucide-react": "^1.26.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.naplanlearning.assistant",
    "productName": "NAPLAN Learning Assistant",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "worker/**/*",
      "shared/**/*",
      "package.json"
    ],
    "win": {
      "icon": "packaging/icons/app-icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NAPLAN Learning Assistant",
      "installerIcon": "packaging/icons/installer-icon.ico",
      "uninstallerIcon": "packaging/icons/installer-icon.ico",
      "installerHeaderIcon": "packaging/icons/installer-icon.ico"
    },
    "portable": {
      "artifactName": "NAPLAN-Learning-Assistant-Portable-${version}-${arch}.${ext}"
    }
  }
}
